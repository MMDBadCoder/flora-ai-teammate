{
  "$schema": "https://opencode.ai/config.json",

  "_comment": [
    "GENERATED by bin/flora render from config/templates/opencode/opencode.json.tmpl.",
    "Hand edits are lost on the next render -- edit the template instead.",
    "The mcp block is assembled from shared/mcp/servers.json so that Hermes and",
    "OpenCode always see the same tool servers."
  ],

  "model": "tokenring/{{FLORA_MODEL_MAIN}}",
  "small_model": "tokenring/{{FLORA_MODEL_SMALL}}",

  "provider": {
    "tokenring": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Flora TokenRing pool",
      "options": {
        "baseURL": "http://127.0.0.1:{{FLORA_PORT_TOKENRING}}/v1",
        "apiKey": "{env:FLORA_TOKENRING_KEY}"
      },
      "models": {{FLORA_OPENCODE_MODELS_JSON}}
    }
  },

  "server": {
    "hostname": "{{FLORA_BIND_ADDR}}",
    "port": {{FLORA_PORT_OPENCODE}}
  },

  "share": "disabled",
  "autoupdate": false,

  "instructions": [
    "{{FLORA_HOME}}/shared/agents/AGENTS.md",
    "{{FLORA_HOME}}/shared/agents/SOUL.md"
  ],

  "mcp": {{OPENCODE_MCP_JSON}}
}
