# ---------------------------------------------------------------------------
# Flora, addressed by port  --  GENERATED by `bin/flora render`, installed to
# /etc/nginx/conf.d/flora.conf by `bin/flora nginx`.
#
# One listener per service, no server_name, no DNS, no /etc/hosts. Reach it at
# http://<this machine's IP>:<port>. Anything already served by this nginx keeps
# working: these blocks answer only on ports nothing else owns, and none of them
# is a default_server.
#
# The backends stay on 127.0.0.1. nginx is the only thing listening publicly,
# which is what lets one account list guard the two agent UIs -- both of which
# can run shell commands on this machine.
# ---------------------------------------------------------------------------

map $http_upgrade $flora_connection_upgrade {
    default upgrade;
    ''      close;
}

log_format flora '$remote_addr - $remote_user [$time_local] '
                 '"$request" $status $body_bytes_sent $request_time';

# ============================ Dashboard :{{FLORA_PUBLIC_DASHBOARD}} =========
server {
    listen {{FLORA_PUBLIC_DASHBOARD}};
    server_name _;

    access_log {{FLORA_HOME}}/state/logs/nginx-dashboard.access.log flora;
    error_log  {{FLORA_HOME}}/state/logs/nginx-dashboard.error.log warn;

    root {{FLORA_HOME}}/state/dashboard;
    index index.html;

    include {{FLORA_HOME}}/state/nginx/dashboard-auth.conf;

    # Liveness for the container's healthcheck and for any external monitor.
    # Outside the account list on purpose: it proves nginx is up, nothing more.
    location = /nginx-health {
        auth_basic off;
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = /health.json {
        add_header Cache-Control "no-store";
        default_type application/json;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

# ============================ Hermes :{{FLORA_PUBLIC_HERMES}} ===============
server {
    listen {{FLORA_PUBLIC_HERMES}};
    server_name _;

    access_log {{FLORA_HOME}}/state/logs/nginx-hermes.access.log flora;
    error_log  {{FLORA_HOME}}/state/logs/nginx-hermes.error.log warn;

    client_max_body_size 256m;
    include {{FLORA_HOME}}/state/nginx/auth.conf;

    location / {
        proxy_pass http://127.0.0.1:{{FLORA_PORT_HERMES}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $flora_connection_upgrade;
        proxy_set_header Host $http_host;
        # Hermes runs its own cookie-session login on top of this gate, so the
        # Authorization header is passed straight through rather than rewritten.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# ============================ OpenCode :{{FLORA_PUBLIC_OPENCODE}} ===========
server {
    listen {{FLORA_PUBLIC_OPENCODE}};
    server_name _;

    access_log {{FLORA_HOME}}/state/logs/nginx-opencode.access.log flora;
    error_log  {{FLORA_HOME}}/state/logs/nginx-opencode.error.log warn;

    client_max_body_size 256m;
    include {{FLORA_HOME}}/state/nginx/auth.conf;

    location / {
        proxy_pass http://127.0.0.1:{{FLORA_PORT_OPENCODE}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $flora_connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Server-sent events carry the agent's output; buffering would stall it.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# ============================ Mattermost :{{FLORA_PUBLIC_CHAT}} =============
# No HTTP basic auth: Mattermost has real accounts, and basic auth would break
# the desktop and mobile clients.
server {
    listen {{FLORA_PUBLIC_CHAT}};
    server_name _;

    access_log {{FLORA_HOME}}/state/logs/nginx-chat.access.log flora;
    error_log  {{FLORA_HOME}}/state/logs/nginx-chat.error.log warn;

    client_max_body_size 512m;

    location ~ /api/v[0-9]+/(users/)?websocket$ {
        proxy_pass http://127.0.0.1:{{FLORA_PORT_MATTERMOST}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_buffers 256 16k;
    }

    location / {
        proxy_pass http://127.0.0.1:{{FLORA_PORT_MATTERMOST}};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_buffers 256 16k;
    }
}

# ============================ TokenRing :{{FLORA_PUBLIC_TOKENS}} ============
# Its dashboard has a password of its own and /v1 is authenticated by sk-ring
# keys, so no basic auth layer here either.
server {
    listen {{FLORA_PUBLIC_TOKENS}};
    server_name _;

    access_log {{FLORA_HOME}}/state/logs/nginx-tokens.access.log flora;
    error_log  {{FLORA_HOME}}/state/logs/nginx-tokens.error.log warn;

    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:{{FLORA_PORT_TOKENRING}};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Token streaming: never buffer, never time out mid-completion.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
