# ---------------------------------------------------------------------------
# Flora vhosts  --  GENERATED by `bin/flora render`, served by Flora's own nginx
# container (or installed to /etc/nginx/conf.d/flora.conf with FLORA_NGINX=host).
#
# Each service is addressed either by port (http://<ip>:7083) or by subdomain
# (http://chat.flora.com), chosen per service: FLORA_ROUTING sets the default and
# FLORA_ROUTE_<SERVICE> overrides it for one. The server blocks below are
# generated by scripts/lib/nginx_render.py; the routing line at the top of them
# says which mode each service ended up in.
#
# Subdomain mode needs each name to resolve -- DNS, or a line in /etc/hosts on
# every machine that browses it (`bin/flora hosts --print`). Port mode needs
# nothing. None of these blocks is a default_server, so anything else this nginx
# already serves keeps working untouched.
#
# The backends stay on their own addresses; nginx is what the team reaches.
# ---------------------------------------------------------------------------

# WebSocket upgrade plumbing, used by Mattermost's realtime channel, the Hermes
# terminal and the OpenCode session stream.
map $http_upgrade $flora_connection_upgrade {
    default upgrade;
    ''      close;
}

log_format flora '$remote_addr - $remote_user [$time_local] "$host" '
                 '"$request" $status $body_bytes_sent $request_time';

{{FLORA_NGINX_SERVERS}}
