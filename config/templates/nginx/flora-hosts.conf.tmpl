# ---------------------------------------------------------------------------
# Flora vhosts  --  GENERATED by `bin/flora render`, installed to
# /etc/nginx/conf.d/flora.conf by `bin/flora nginx`.
#
# Name-based virtual hosting: one IP, five hostnames, no DNS involved. Each
# hostname must appear in /etc/hosts on every machine that browses it --
# /etc/hosts has no wildcard support, so *.flora.com will NOT work; the names
# are listed one by one. `bin/flora hosts` prints the exact line to paste.
#
# None of these blocks is a default_server, so anything already served by this
# nginx keeps working untouched.
# ---------------------------------------------------------------------------

# WebSocket upgrade plumbing, used by Mattermost, the Hermes terminal and the
# OpenCode session stream.
map $http_upgrade $flora_connection_upgrade {
    default upgrade;
    ''      close;
}

log_format flora '$remote_addr - $remote_user [$time_local] "$host" '
                 '"$request" $status $body_bytes_sent $request_time';

# Shared proxy behaviour. Long timeouts because an agent turn can legitimately
# run for minutes, and buffering off because everything here streams tokens.
# (Included from each location below.)

# ============================ 1. Dashboard =================================
server {
    listen {{FLORA_HTTP_PORT}};
    server_name {{FLORA_HOST_DASHBOARD}};

    access_log {{FLORA_HOME}}/state/logs/nginx-dashboard.access.log flora;
    error_log  {{FLORA_HOME}}/state/logs/nginx-dashboard.error.log warn;

    root {{FLORA_HOME}}/web/dashboard;
    index index.html;

    include {{FLORA_HOME}}/state/nginx/auth.conf;

    # Liveness for the container's healthcheck and for any external monitor.
    # Outside the account list on purpose: it proves nginx is up, nothing more.
    location = /nginx-health {
        auth_basic off;
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = /health.json {
        alias {{FLORA_HOME}}/state/dashboard/health.json;
        add_header Cache-Control "no-store";
        default_type application/json;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

# ============================ 2. Hermes ====================================
server {
    listen {{FLORA_HTTP_PORT}};
    server_name {{FLORA_HOST_HERMES}};

    access_log {{FLORA_HOME}}/state/logs/nginx-hermes.access.log flora;
    error_log  {{FLORA_HOME}}/state/logs/nginx-hermes.error.log warn;

    client_max_body_size 256m;

    include {{FLORA_HOME}}/state/nginx/auth.conf;

    location / {
        proxy_pass http://127.0.0.1:{{FLORA_PORT_HERMES}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $flora_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# ============================ 3. OpenCode ==================================
server {
    listen {{FLORA_HTTP_PORT}};
    server_name {{FLORA_HOST_OPENCODE}};

    access_log {{FLORA_HOME}}/state/logs/nginx-opencode.access.log flora;
    error_log  {{FLORA_HOME}}/state/logs/nginx-opencode.error.log warn;

    client_max_body_size 256m;

    include {{FLORA_HOME}}/state/nginx/auth.conf;

    location / {
        proxy_pass http://127.0.0.1:{{FLORA_PORT_OPENCODE}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $flora_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Server-sent events carry the agent's output; buffering would stall it.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# ============================ 4. Mattermost ================================
# Deliberately NOT behind HTTP basic auth: Mattermost has real accounts, and
# basic auth would break the desktop and mobile clients.
server {
    listen {{FLORA_HTTP_PORT}};
    server_name {{FLORA_HOST_CHAT}};

    access_log {{FLORA_HOME}}/state/logs/nginx-chat.access.log flora;
    error_log  {{FLORA_HOME}}/state/logs/nginx-chat.error.log warn;

    client_max_body_size 512m;

    location ~ /api/v[0-9]+/(users/)?websocket$ {
        proxy_pass http://127.0.0.1:{{FLORA_PORT_MATTERMOST}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_buffers 256 16k;
    }

    location / {
        proxy_pass http://127.0.0.1:{{FLORA_PORT_MATTERMOST}};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_buffers 256 16k;
    }
}

# ============================ 5. TokenRing =================================
server {
    listen {{FLORA_HTTP_PORT}};
    server_name {{FLORA_HOST_TOKENS}};

    access_log {{FLORA_HOME}}/state/logs/nginx-tokens.access.log flora;
    error_log  {{FLORA_HOME}}/state/logs/nginx-tokens.error.log warn;

    client_max_body_size 64m;

    # The dashboard has its own password login, and /v1 is authenticated by
    # sk-ring keys, so no basic auth layer here either.
    location / {
        proxy_pass http://127.0.0.1:{{FLORA_PORT_TOKENRING}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Token streaming: never buffer, never time out mid-completion.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
