# ---------------------------------------------------------------------------
# Flora's own nginx  --  GENERATED by `bin/flora render`.
#
# Port-based addressing made this possible: with no name-based vhosts there is
# nothing to share with a host nginx, so Flora runs her own and writes nothing
# to /etc/nginx. The host does not even need nginx installed.
#
# WHY network_mode: host.
# The backends (TokenRing, Hermes, OpenCode, Mattermost's published port) all
# listen on 127.0.0.1, which is exactly what keeps them off the network while
# one account list guards the agent UIs. A bridge-networked container cannot
# reach a host loopback socket -- it would arrive from the bridge gateway and be
# refused -- so the alternative would be binding the backends to 0.0.0.0, which
# is the thing the whole design avoids.
#
# Host networking also means the generated flora.conf is byte-identical whether
# a host nginx or this container serves it: one file, two runtimes.
#
# `ports:` is therefore absent and would be ignored; nginx binds
# {{FLORA_PUBLIC_DASHBOARD}}-{{FLORA_PUBLIC_TOKENS}} on the host directly.
#
# Only four paths are mounted, read-only except the logs. secrets/ is
# deliberately not among them: nginx has no business reading it.
# ---------------------------------------------------------------------------
name: flora-nginx

services:
  nginx:
    image: nginx:1.27-alpine
    container_name: flora-nginx
    restart: unless-stopped
    network_mode: host
    security_opt: ["no-new-privileges:true"]
    volumes:
      # The image ships its own default.conf listening on :80. Under host
      # networking that collides with whatever already owns :80 on this machine
      # and nginx refuses to start, so it is masked out.
      - /dev/null:/etc/nginx/conf.d/default.conf:ro
      # A one-line `include` stub, not flora.conf itself -- a single-file bind
      # mount goes stale the moment the host file is replaced via mktemp+mv
      # (a new inode), which is exactly how flora.conf gets rewritten on every
      # config change. This stub's own content is near-constant, so IT is safe
      # to bind-mount directly; it hands off to the real flora.conf through
      # the directory mount below, which has no such staleness problem. See
      # render.sh, in the block that writes state/nginx/loader.conf.
      - {{FLORA_HOME}}/state/nginx/loader.conf:/etc/nginx/conf.d/flora.conf:ro
      # Mounted at their real paths, because the generated config refers to them
      # by absolute path and that same file has to work under a host nginx too.
      - {{FLORA_HOME}}/state/nginx:{{FLORA_HOME}}/state/nginx:ro
      - {{FLORA_HOME}}/state/dashboard:{{FLORA_HOME}}/state/dashboard:ro
      - {{FLORA_HOME}}/state/logs:{{FLORA_HOME}}/state/logs:rw
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1:{{FLORA_PUBLIC_DASHBOARD}}/nginx-health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
