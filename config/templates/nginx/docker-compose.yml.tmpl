# ---------------------------------------------------------------------------
# Flora's own nginx  --  GENERATED by `bin/flora render`.
#
# Port-based addressing made this possible: with no name-based vhosts there is
# nothing to share with a host nginx, so Flora can run her own and stop writing
# to /etc/nginx at all. That leaves the git checkout and this directory as the
# platform's entire footprint on the machine.
#
# Bridge networking with published ports, not network_mode: host. Host mode
# would be marginally simpler on a plain Linux box, but on Docker Desktop and
# WSL "host" is the Linux VM rather than the machine you browse from, and the
# ports would not be reachable. Published ports work everywhere.
#
# The backends are on the host's loopback, so the container reaches them through
# host.docker.internal, which extra_hosts maps to the gateway address.
#
# Only four paths are mounted, all read-only except the log directory. secrets/
# is deliberately not among them: nginx has no business reading it.
# ---------------------------------------------------------------------------
name: flora-nginx

services:
  nginx:
    image: nginx:1.27-alpine
    container_name: flora-nginx
    restart: unless-stopped
    security_opt: ["no-new-privileges:true"]
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "{{FLORA_PUBLIC_DASHBOARD}}:{{FLORA_PUBLIC_DASHBOARD}}"
      - "{{FLORA_PUBLIC_HERMES}}:{{FLORA_PUBLIC_HERMES}}"
      - "{{FLORA_PUBLIC_OPENCODE}}:{{FLORA_PUBLIC_OPENCODE}}"
      - "{{FLORA_PUBLIC_CHAT}}:{{FLORA_PUBLIC_CHAT}}"
      - "{{FLORA_PUBLIC_TOKENS}}:{{FLORA_PUBLIC_TOKENS}}"
    volumes:
      # The generated vhosts, dropped straight into the image's conf.d.
      - {{FLORA_HOME}}/state/nginx/flora.conf:/etc/nginx/conf.d/flora.conf:ro
      # Mounted at their real paths, because the generated config refers to them
      # by absolute path and the same file then works under a host nginx too.
      - {{FLORA_HOME}}/state/nginx:{{FLORA_HOME}}/state/nginx:ro
      - {{FLORA_HOME}}/web/dashboard:{{FLORA_HOME}}/web/dashboard:ro
      - {{FLORA_HOME}}/state/dashboard:{{FLORA_HOME}}/state/dashboard:ro
      - {{FLORA_HOME}}/state/logs:{{FLORA_HOME}}/state/logs:rw
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://localhost:{{FLORA_PUBLIC_DASHBOARD}}/health.json"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
