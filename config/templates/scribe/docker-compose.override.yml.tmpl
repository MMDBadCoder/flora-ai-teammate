# Flora's overrides for Scribe  --  GENERATED by `bin/flora render`.
#
# Used as:  docker compose -f <checkout>/docker-compose.yml -f this-file ...
#
# Upstream's compose file is used exactly as shipped. This adds only what Flora
# needs on top, through Compose's own documented multi-file merge:
#
#   - data and models move OUT of the checkout, so reinstalling or moving to a
#     new release never touches recordings or transcripts. Upstream mounts
#     ./data and ./models relative to its own file; these absolute paths replace
#     those mounts by target.
#   - a stable project name, so the containers are called flora-scribe-* rather
#     than being named after whatever directory the checkout happens to sit in.
#
# Nothing here reaches into how the app works -- that stays upstream's business.
name: flora-scribe

services:
  api:
    volumes:
      - {{FLORA_HOME}}/state/scribe/data:/srv/data
      - {{FLORA_HOME}}/state/scribe/models:/srv/models:ro

  worker:
    volumes:
      - {{FLORA_HOME}}/state/scribe/data:/srv/data
      - {{FLORA_HOME}}/state/scribe/models:/srv/models:ro

  bale:
    volumes:
      - {{FLORA_HOME}}/state/scribe/data:/srv/data
      - {{FLORA_HOME}}/state/scribe/models:/srv/models:ro
