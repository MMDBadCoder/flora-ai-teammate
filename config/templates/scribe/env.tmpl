# Scribe (upstream: voice-2-text) configuration  --  GENERATED by `bin/flora render`.
#
# This is upstream's own .env contract, filled in from flora.env. Anything not
# set here keeps upstream's default, deliberately: Flora configures the handful
# of things it owns -- where it listens, where data goes, how big the pool is --
# and leaves the transcription tuning to upstream's documentation.
#
# Every key below is one upstream publishes in its .env.example.

# --- where it listens (nginx proxies to this) -------------------------------
HOST={{FLORA_BIND_ADDR}}
PORT={{FLORA_PORT_SCRIBE}}
LOG_LEVEL=INFO

# --- worker pool ------------------------------------------------------------
WORKER_COUNT={{FLORA_SCRIBE_WORKERS}}
WORKER_CPU_THREADS={{FLORA_SCRIBE_CPU_THREADS}}

# --- transcription backend --------------------------------------------------
# stub needs no model and fabricates text, which is enough to exercise the UI,
# the queue and the exports. faster_whisper needs a model prepared into
# state/scribe/models per upstream's docs/SETUP.md.
ASR_BACKEND={{FLORA_SCRIBE_ASR_BACKEND}}

# --- accounts ---------------------------------------------------------------
# Scribe has its own accounts, like Mattermost and TokenRing, so it is not put
# behind Flora's account list. The first administrator is created from these on
# first start; blank means no bootstrap admin and you register through the UI.
BOOTSTRAP_ADMIN_PHONE={{SCRIBE_ADMIN_PHONE}}
BOOTSTRAP_ADMIN_PASSWORD={{SCRIBE_ADMIN_PASSWORD}}

# Upstream uses this to build absolute URLs; it has to be what the browser typed.
PUBLIC_BASE_URL={{FLORA_URL_SCRIBE}}
