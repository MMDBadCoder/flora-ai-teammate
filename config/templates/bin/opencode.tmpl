#!/usr/bin/env bash
# Flora's OpenCode wrapper  --  GENERATED by `bin/flora render`.
#
# OpenCode follows XDG and drops auth.json into ~/.local/share by default, so
# HOME itself is redirected into the Flora tree. That keeps credentials,
# sessions, caches and the global AGENTS.md all inside one backed-up directory.
set -euo pipefail

export FLORA_HOME="{{FLORA_HOME}}"
export HOME="$FLORA_HOME/state/opencode/home"
export XDG_CONFIG_HOME="$FLORA_HOME/state/opencode/xdg/config"
export XDG_DATA_HOME="$FLORA_HOME/state/opencode/xdg/data"
export XDG_STATE_HOME="$FLORA_HOME/state/opencode/xdg/state"
export XDG_CACHE_HOME="$FLORA_HOME/state/opencode/xdg/cache"
export OPENCODE_CONFIG_DIR="$FLORA_HOME/state/opencode/config"
export OPENCODE_CONFIG="$OPENCODE_CONFIG_DIR/opencode.json"
export OPENCODE_DISABLE_AUTOUPDATE=1
mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME" "$OPENCODE_CONFIG_DIR"

set -a
[ -f "$FLORA_HOME/flora.env" ] && . "$FLORA_HOME/flora.env"
[ -f "$FLORA_HOME/secrets/flora.env" ] && . "$FLORA_HOME/secrets/flora.env"
set +a

NPM_ROOT="$FLORA_HOME/state/opencode/npm"
for candidate in \
    "${FLORA_OPENCODE_BIN:-}" \
    "$NPM_ROOT/node_modules/.bin/opencode" \
    "$NPM_ROOT/bin/opencode" \
    "/usr/local/bin/opencode" \
    "$(command -v opencode 2>/dev/null || true)"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then exec "$candidate" "$@"; fi
done
echo "opencode binary not found. Run: $FLORA_HOME/scripts/install-opencode.sh" >&2
exit 127
