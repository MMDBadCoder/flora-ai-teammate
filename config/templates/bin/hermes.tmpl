#!/usr/bin/env bash
# Flora's Hermes wrapper  --  GENERATED by `bin/flora render`.
#
# Runs FLORA'S OWN Hermes: its own checkout, its own Python runtime, its own
# HOME, its own data. It shares nothing with a Hermes that was already on this
# machine, and it will not fall back to one -- a fallback is how you end up
# running someone else's binary against Flora's data without noticing.
#
# Always use this wrapper (or `bin/flora hermes ...`). A bare `hermes` is the
# other install, if there is one.
set -euo pipefail

export FLORA_HOME="{{FLORA_HOME}}"

# A HOME of Flora's own: the installer's PATH edits, shell rc files and
# ~/.local/bin shims all land here, and ~/.ssh and ~/.gitconfig are hers, not
# the operator's. Give her a Gerrit key at $HOME/.ssh/ if she needs one.
export HOME="$FLORA_HOME/state/hermes/fs-home"
export HERMES_HOME="$FLORA_HOME/state/hermes/home"
export HERMES_INSTALL_DIR="$FLORA_HOME/state/hermes/agent"
export HERMES_RUNTIME_DIR="$FLORA_HOME/state/hermes/tools"
export XDG_DATA_HOME="$FLORA_HOME/state/hermes/xdg/data"
export XDG_CACHE_HOME="$FLORA_HOME/state/hermes/xdg/cache"
export XDG_STATE_HOME="$FLORA_HOME/state/hermes/xdg/state"
export XDG_CONFIG_HOME="$FLORA_HOME/state/hermes/xdg/config"
mkdir -p "$HOME/.local/bin" "$HERMES_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" \
         "$XDG_STATE_HOME" "$XDG_CONFIG_HOME"
export PATH="$HERMES_RUNTIME_DIR/bin:$HOME/.local/bin:$PATH"

# flora.env first, then secrets, so secrets win.
set -a
[ -f "$FLORA_HOME/flora.env" ] && . "$FLORA_HOME/flora.env"
[ -f "$FLORA_HOME/secrets/flora.env" ] && . "$FLORA_HOME/secrets/flora.env"
set +a

PRIVATE_BIN="$HERMES_INSTALL_DIR/.hermes/bin/hermes"
if [ -x "$PRIVATE_BIN" ]; then
  exec "$PRIVATE_BIN" "$@"
fi

# FLORA_HERMES_BIN is the deliberate escape hatch for an install done by hand.
# It has to be set on purpose; nothing is auto-discovered from PATH.
if [ -n "${FLORA_HERMES_BIN:-}" ] && [ -x "${FLORA_HERMES_BIN}" ]; then
  case "$FLORA_HERMES_BIN" in
    "$FLORA_HOME"/*) : ;;
    *) echo "flora: warning -- using a Hermes outside the Flora tree:" >&2
       echo "       $FLORA_HERMES_BIN" >&2
       echo "       Run scripts/install-hermes.sh for a private copy." >&2 ;;
  esac
  exec "$FLORA_HERMES_BIN" "$@"
fi

cat >&2 <<MSG
flora: Flora has no Hermes of her own yet.

  expected: $PRIVATE_BIN
  install:  $FLORA_HOME/scripts/install-hermes.sh

A "hermes" already on your PATH is deliberately NOT used -- Flora keeps her own.
MSG
exit 127
