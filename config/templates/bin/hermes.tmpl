#!/usr/bin/env bash
# Flora's Hermes wrapper  --  GENERATED by `bin/flora render`.
#
# Runs the real hermes binary with every state path pointed inside the Flora
# tree. Always use this wrapper (or `bin/flora hermes ...`) instead of bare
# `hermes`: a bare call would read ~/.hermes and quietly build a second,
# un-backed-up brain next to this one.
set -euo pipefail

export FLORA_HOME="{{FLORA_HOME}}"
export HERMES_HOME="$FLORA_HOME/state/hermes/home"
export XDG_DATA_HOME="$FLORA_HOME/state/hermes/xdg/data"
export XDG_CACHE_HOME="$FLORA_HOME/state/hermes/xdg/cache"
export XDG_STATE_HOME="$FLORA_HOME/state/hermes/xdg/state"
mkdir -p "$HERMES_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"

# flora.env first, then secrets, so secrets win.
set -a
[ -f "$FLORA_HOME/flora.env" ] && . "$FLORA_HOME/flora.env"
[ -f "$FLORA_HOME/secrets/flora.env" ] && . "$FLORA_HOME/secrets/flora.env"
set +a

for candidate in \
    "${FLORA_HERMES_BIN:-}" \
    "$HOME/.local/bin/hermes" \
    "/usr/local/bin/hermes" \
    "$(command -v hermes 2>/dev/null || true)"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then exec "$candidate" "$@"; fi
done
echo "hermes binary not found. Run: $FLORA_HOME/scripts/install-hermes.sh" >&2
exit 127
