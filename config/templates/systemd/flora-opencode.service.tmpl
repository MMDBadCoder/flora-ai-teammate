[Unit]
Description=Flora / OpenCode web  --  browser coding agent
Documentation=file://{{FLORA_HOME}}/docs/04-operations.md
After=network-online.target flora-tokenring.service
Wants=network-online.target
PartOf=flora.target

[Service]
Type=simple
User={{FLORA_USER}}
WorkingDirectory={{FLORA_HOME}}/workspace
EnvironmentFile={{FLORA_HOME}}/flora.env
EnvironmentFile=-{{FLORA_HOME}}/secrets/flora.env
# `opencode web` tries to xdg-open a browser even with BROWSER=true set (that
# env var is not honoured by current builds), which crashes with "Executable
# not found: xdg-open" on every headless start. `serve` renders the identical
# web UI without ever trying to launch one, so it is the correct subcommand
# here, not just a fallback for builds that lack `web`.
# Exactly one authentication layer. With FLORA_AUTH_MODE=nginx this unsets
# OpenCode's own password so it does not reject the credentials nginx forwards.
{{FLORA_OPENCODE_AUTH_DIRECTIVE}}
ExecStart={{FLORA_HOME}}/state/bin/opencode serve --hostname {{FLORA_BIND_ADDR}} --port {{FLORA_PORT_OPENCODE}} --print-logs
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=append:{{FLORA_HOME}}/state/logs/opencode.log
StandardError=append:{{FLORA_HOME}}/state/logs/opencode.log

[Install]
WantedBy=multi-user.target
