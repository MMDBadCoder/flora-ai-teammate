[Unit]
Description=Flora / nginx  --  the only public listener, in Flora's own container
Documentation=file://{{FLORA_HOME}}/docs/01-architecture.md
After=network-online.target docker.service
Requires=docker.service
PartOf=flora.target

[Service]
# The container carries restart=unless-stopped itself; this unit exists so the
# whole platform starts and stops with one command.
Type=oneshot
RemainAfterExit=yes
User={{FLORA_USER}}
WorkingDirectory={{FLORA_HOME}}/state/nginx
ExecStart=/usr/bin/docker compose -f {{FLORA_HOME}}/state/nginx/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f {{FLORA_HOME}}/state/nginx/docker-compose.yml stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
