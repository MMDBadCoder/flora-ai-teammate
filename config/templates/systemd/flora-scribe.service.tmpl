[Unit]
Description=Flora / Scribe  --  offline Persian meeting transcription
Documentation=file://{{FLORA_HOME}}/docs/07-integrations.md
After=network-online.target docker.service
Requires=docker.service
PartOf=flora.target

[Service]
# The containers carry restart=unless-stopped themselves; this unit exists so
# the whole platform starts and stops with one command.
Type=oneshot
RemainAfterExit=yes
User={{FLORA_USER}}
WorkingDirectory={{FLORA_HOME}}/state/scribe
ExecStart=/usr/bin/docker compose -f {{FLORA_HOME}}/state/scribe/src/docker-compose.yml -f {{FLORA_HOME}}/state/scribe/docker-compose.override.yml up -d --remove-orphans --scale worker={{FLORA_SCRIBE_WORKERS}}
ExecStop=/usr/bin/docker compose -f {{FLORA_HOME}}/state/scribe/src/docker-compose.yml -f {{FLORA_HOME}}/state/scribe/docker-compose.override.yml stop
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
