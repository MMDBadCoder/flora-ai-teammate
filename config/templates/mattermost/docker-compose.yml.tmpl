# ---------------------------------------------------------------------------
# Mattermost for Flora  --  GENERATED by `bin/flora render`.
#
# Two containers, both with bind mounts into state/mattermost/ rather than
# named Docker volumes. That is deliberate: a named volume lives under
# /var/lib/docker, outside this directory. Everything here
# is inside the Flora tree.
#
# Postgres is NOT published to the host: only the Mattermost container reaches
# it, over the private compose network. The host already runs a Postgres on
# 5432 and this one must not collide with it.
# ---------------------------------------------------------------------------
name: flora-mattermost

services:
  postgres:
    image: postgres:16-alpine
    container_name: flora-mm-postgres
    restart: unless-stopped
    security_opt: ["no-new-privileges:true"]
    environment:
      POSTGRES_USER: mmuser
      POSTGRES_PASSWORD: {{MATTERMOST_DB_PASSWORD}}
      POSTGRES_DB: mattermost
      TZ: {{FLORA_TZ}}
    volumes:
      - {{FLORA_HOME}}/state/mattermost/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U mmuser -d mattermost"]
      interval: 10s
      timeout: 5s
      retries: 10

  mattermost:
    image: mattermost/mattermost-team-edition:10.5
    container_name: flora-mattermost
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    security_opt: ["no-new-privileges:true"]
    # The image runs as uid 2000; the install script chowns these paths to match.
    user: "2000:2000"
    ports:
      - "{{FLORA_BIND_ADDR}}:{{FLORA_PORT_MATTERMOST}}:8065"
    environment:
      TZ: {{FLORA_TZ}}
      MM_SQLSETTINGS_DRIVERNAME: postgres
      MM_SQLSETTINGS_DATASOURCE: "postgres://mmuser:{{MATTERMOST_DB_PASSWORD}}@postgres:5432/mattermost?sslmode=disable&connect_timeout=10"
      MM_BLEVESETTINGS_INDEXDIR: /mattermost/bleve-indexes
      # Must match what the browser types, or websockets and OAuth break.
      MM_SERVICESETTINGS_SITEURL: http://{{FLORA_HOST_CHAT}}
      MM_SERVICESETTINGS_ENABLELOCALMODE: "true"
      MM_SERVICESETTINGS_LOCALMODESOCKETLOCATION: /var/tmp/mattermost_local.socket
      # Flora's gateway logs in as a bot account, so bot accounts must be on.
      MM_SERVICESETTINGS_ENABLEBOTACCOUNTCREATION: "true"
      MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS: "true"
      # This is an internal team server: no open sign-up, invite only.
      MM_TEAMSETTINGS_ENABLEOPENSERVER: "false"
      MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS: "false"
      MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION: "false"
      MM_LOGSETTINGS_ENABLEFILE: "true"
      MM_LOGSETTINGS_FILELOCATION: /mattermost/logs
    volumes:
      - {{FLORA_HOME}}/state/mattermost/config:/mattermost/config:rw
      - {{FLORA_HOME}}/state/mattermost/data:/mattermost/data:rw
      - {{FLORA_HOME}}/state/mattermost/logs:/mattermost/logs:rw
      - {{FLORA_HOME}}/state/mattermost/plugins:/mattermost/plugins:rw
      - {{FLORA_HOME}}/state/mattermost/client-plugins:/mattermost/client/plugins:rw
      - {{FLORA_HOME}}/state/mattermost/bleve-indexes:/mattermost/bleve-indexes:rw
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8065/api/v4/system/ping"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s
