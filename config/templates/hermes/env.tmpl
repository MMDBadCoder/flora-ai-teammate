# Hermes secrets  --  GENERATED from secrets/flora.env by `bin/flora render`.
# Mode 0600. Never commit. Hermes reads this file itself on every invocation,
# which is what makes `hermes chat` from a plain shell work the same as the
# systemd units.

# --- LLM access: the local TokenRing pool, never the provider directly ------
FLORA_TOKENRING_KEY={{FLORA_TOKENRING_KEY}}
OPENAI_API_KEY={{FLORA_TOKENRING_KEY}}
OPENAI_BASE_URL=http://127.0.0.1:{{FLORA_PORT_TOKENRING}}/v1

# --- Mattermost bot (the gateway logs in as Flora with this) ----------------
MATTERMOST_URL=http://127.0.0.1:{{FLORA_PORT_MATTERMOST}}
MATTERMOST_TOKEN={{MATTERMOST_BOT_TOKEN}}
MATTERMOST_ALLOWED_USERS={{MATTERMOST_ALLOWED_USERS}}
MATTERMOST_REPLY_MODE=thread

# --- Dashboard --------------------------------------------------------------
HERMES_DASHBOARD_PUBLIC_URL=http://{{FLORA_HOST_HERMES}}
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{FLORA_ADMIN_USER}}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{HERMES_DASHBOARD_PASSWORD}}

# --- Code review / docs integrations (fill these in: bin/flora secrets edit) -
GERRIT_URL={{GERRIT_URL}}
GERRIT_USER={{GERRIT_USER}}
GERRIT_HTTP_PASSWORD={{GERRIT_HTTP_PASSWORD}}
CONFLUENCE_URL={{CONFLUENCE_URL}}
CONFLUENCE_USER={{CONFLUENCE_USER}}
CONFLUENCE_TOKEN={{CONFLUENCE_TOKEN}}
