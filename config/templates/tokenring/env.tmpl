# TokenRing environment  --  GENERATED by `bin/flora render`.
# Consumed by the flora-tokenring systemd unit.

TOKENRING_HOST={{FLORA_BIND_ADDR}}
TOKENRING_PORT={{FLORA_PORT_TOKENRING}}

# The database lives inside the Flora tree, so it travels with the directory.
# It holds every upstream API key (encrypted with TOKENRING_ENCRYPTION_KEY)
# and every issued sk-ring key. Losing master.key means losing the pool.
TOKENRING_DATA_DIR={{FLORA_HOME}}/state/tokenring/data
TOKENRING_ENCRYPTION_KEY={{TOKENRING_ENCRYPTION_KEY}}
TOKENRING_ADMIN_PASSWORD={{TOKENRING_ADMIN_PASSWORD}}

TOKENRING_PUBLIC_URL=http://{{FLORA_HOST_TOKENS}}
TOKENRING_DEFAULT_PROVIDER_NAME=Default
TOKENRING_DEFAULT_PROVIDER_BASE_URL={{FLORA_TOKENRING_UPSTREAM}}
TOKENRING_SESSION_TTL_HOURS=168
TOKENRING_LOG_LEVEL=info

# We always sit behind our own nginx, so X-Forwarded-For can be trusted.
TOKENRING_TRUST_PROXY=1
