# =============================================================================
# Flora platform configuration  --  copy to flora.env and edit
#
#   cp flora.env.example flora.env
#
# This file holds NON-SECRET settings only. It is read by every script and by
# every systemd unit (EnvironmentFile=). Secrets live in secrets/*.env (0600,
# git-ignored). After changing anything here, run:  bin/flora render && bin/flora restart
# =============================================================================

# --- Identity ----------------------------------------------------------------
# FLORA_HOME is not set here: it is derived from where these scripts live, so
# the platform keeps working if you move or rename the directory.
FLORA_DOMAIN=flora.com
# IP that team members' /etc/hosts should point at (the VPS's reachable address).
FLORA_IP=192.0.2.10
FLORA_TZ=UTC
# Unix account that owns and runs everything.
# Owns the tree and runs the services. Unset means whoever runs the command
# ($SUDO_USER under sudo), so an install with sudo does not leave a root-only tree.
#FLORA_USER=

# --- Addressing --------------------------------------------------------------
# ports : reach each service at http://<server ip>:<port>. No DNS, no
#         /etc/hosts, nothing for teammates to configure. (default)
# hosts : name-based virtual hosts on one port (http://hermes.flora.com), which
#         needs a line in /etc/hosts on every machine that browses it.
FLORA_ROUTING=ports

# Who runs nginx.
# docker : Flora runs her own in a container. Nothing is written to /etc/nginx,
#          the host does not need nginx installed, and uninstalling is a
#          `compose down`. (default)
# host   : use the nginx already on this machine, via /etc/nginx/conf.d.
FLORA_NGINX=docker

# The ports nginx serves on, in `ports` mode. Pick anything free; they are what
# people type. The dashboard links to the others, so nobody memorises them.
FLORA_PUBLIC_DASHBOARD=7080
FLORA_PUBLIC_HERMES=7081
FLORA_PUBLIC_OPENCODE=7082
FLORA_PUBLIC_CHAT=7083
FLORA_PUBLIC_TOKENS=7084

# Behind a NAT gateway, container port-forward or reverse proxy that
# translates ports (an external host:28001 forwarded to this machine's own
# FLORA_PUBLIC_CHAT), FLORA_IP:FLORA_PUBLIC_* can't express the external
# address, since it assumes the port people type is the port nginx binds here.
# Set the override for whichever service is reached this way -- it changes
# only what gets advertised (links, Mattermost's SiteURL); nginx still listens
# on FLORA_PUBLIC_* as normal. Leave blank unless you have this problem.
#FLORA_URL_DASHBOARD_OVERRIDE=
#FLORA_URL_HERMES_OVERRIDE=
#FLORA_URL_OPENCODE_OVERRIDE=
#FLORA_URL_CHAT_OVERRIDE=
#FLORA_URL_TOKENS_OVERRIDE=

# --- Hostnames (only used when FLORA_ROUTING=hosts) --------------------------
# Each needs its own /etc/hosts line -- hosts files have no wildcards.
FLORA_HOST_DASHBOARD=flora.com
FLORA_HOST_HERMES=hermes.flora.com
FLORA_HOST_OPENCODE=opencode.flora.com
FLORA_HOST_CHAT=chat.flora.com
FLORA_HOST_TOKENS=tokens.flora.com

# --- Networking --------------------------------------------------------------
# Where backends listen.
# 0.0.0.0   : also reachable directly on the ports below, from any address --
#             not just through nginx via FLORA_IP. (default) Hermes enforces
#             DNS-rebinding protection that otherwise rejects every Host
#             header except the one exact FLORA_IP; 0.0.0.0 is what makes a
#             plain install reachable from whatever address each teammate
#             actually uses (a LAN IP, a VPN address, localhost over a
#             tunnel) without extra config. Requires FLORA_AUTH_MODE=backend
#             below -- paired together, nothing is unauthenticated, each
#             backend just enforces its own password instead of one shared
#             nginx list.
# 127.0.0.1 : reachable only through nginx via FLORA_IP. More locked down,
#             but only that one address works -- see FLORA_AUTH_MODE below
#             and docs/08-troubleshooting.md#hermes-says-invalid-host-header
#             if you switch to this and Hermes starts rejecting people.
FLORA_BIND_ADDR=0.0.0.0
# Port nginx serves the vhosts on in `hosts` mode only.
FLORA_HTTP_PORT=80

FLORA_PORT_TOKENRING=4000
FLORA_PORT_HERMES=9119
FLORA_PORT_OPENCODE=4096
FLORA_PORT_MATTERMOST=8065

# --- Authentication ----------------------------------------------------------
# backend : each backend enforces its own password, nginx just proxies. (default,
#           paired with FLORA_BIND_ADDR=0.0.0.0 above) The dashboard has no
#           backend of its own, so it always stays behind nginx's account list
#           regardless of this setting -- see render.sh.
# nginx   : one shared HTTP-basic account list in nginx guards every agent UI
#           too; requires FLORA_BIND_ADDR=127.0.0.1 (render.sh refuses the
#           combination otherwise -- pairing nginx-only auth with a
#           non-loopback bind would leave OpenCode's shell access with no
#           authentication at all on every interface).
FLORA_AUTH_MODE=backend
# Mattermost has real user accounts, so it is never put behind HTTP basic auth.
FLORA_ADMIN_USER=admin
FLORA_ADMIN_EMAIL=admin@flora.com

# --- Models (names as TokenRing advertises them to clients) ------------------
FLORA_MODEL_MAIN=gpt-5.1
FLORA_MODEL_SMALL=gpt-5.1-mini
# Upstream the TokenRing pool forwards to. Change in the TokenRing UI later.
FLORA_TOKENRING_UPSTREAM=https://api.openai.com/v1

# Which TokenRing to build. A branch, a tag, or a full commit SHA. Pinned to a
# tagged release rather than `main` so every LLM call's proxy does not change
# under you between one `bin/flora install tokenring` and the next -- bump this
# deliberately, on your own schedule, when a new tag is out.
FLORA_TOKENRING_REF=v0.1.1

# Include Hermes' browser tooling (Playwright). It is a large download and the
# most common way a first install fails on a restricted network, so it is off by
# default. Turn it on if you want Flora to be able to drive a browser.
FLORA_HERMES_BROWSER=false

# --- Skill sharing -----------------------------------------------------------
# Hermes category directory that maps onto shared/skills/.
FLORA_HERMES_SKILL_CATEGORY=team
# Also expose Hermes' own bundled skills to OpenCode (noisy; off by default).
FLORA_SKILLS_EXPORT_BUNDLED=false

# --- Housekeeping ------------------------------------------------------------
FLORA_LOG_KEEP_DAYS=30
FLORA_SESSION_KEEP_DAYS=90

# --- Feature switches --------------------------------------------------------
FLORA_ENABLE_TOKENRING=true
FLORA_ENABLE_HERMES=true
FLORA_ENABLE_OPENCODE=true
FLORA_ENABLE_MATTERMOST=true
